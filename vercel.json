{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/portal", "destination": "/" },
    { "source": "/admin", "destination": "/" },
    { "source": "/portal/:path*", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" }
  ]
}
